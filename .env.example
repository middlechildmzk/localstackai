DATABASE_URL=postgresql://sourcing:sourcing@localhost:5432/sourcing
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=candidates
OPENSEARCH_SHARDS=1
OPENSEARCH_REPLICAS=0

OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECS=15

IDENTITY_MATCH_THRESHOLD=0.85
GITHUB_RATE_LIMIT_MAX=30
GITHUB_RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
