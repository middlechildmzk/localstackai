# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (transactional email)
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=hello@stackbuilder.ai
RESEND_FROM_NAME=StackBuilder AI

# PostHog (analytics) — or swap for Plausible
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StackBuilder AI

# Admin
ADMIN_EMAIL=admin@stackbuilder.ai

# Cron / background jobs (Vercel Cron secret)
CRON_SECRET=your-cron-secret
